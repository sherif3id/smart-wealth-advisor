# Next.js BFF (server-only)
BACKEND_URL=http://localhost:8000
COOKIE_SECURE=false
GEMINI_API_KEY=replace_with_server_side_key
# Ordered fallback list; override when Google changes available models for your project.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Core backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://wealth_app:replace_password@localhost:5432/smart_wealth
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ISSUER=smart-wealth-core
JWT_AUDIENCE=smart-wealth-bff
ACCESS_TOKEN_MINUTES=30
ML_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
AUTO_CREATE_TABLES=false
REQUEST_TIMEOUT_SECONDS=8

# ML service. Production must remain false for synthetic demo artifacts.
ML_MODELS_DIR=./ml-service/models
ML_ALLOW_SYNTHETIC_DEMO=false

# PostgreSQL container
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# Optional SMTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASS=google_app_password_or_smtp_secret
NOTIFICATION_FROM="Smart Wealth Advisor <sender@example.com>"

# Required for scheduled notification dispatch
CRON_SECRET=replace_with_a_long_random_secret
